{
  "$comment": [
    "Tamper-protection verdicts every surface that reaches a verdict must agree on:",
    "block-hook-tampering.py directly, and Pi's hook runner over its registration.",
    "Every agent carries every agent's set,",
    "because an agent able to rewrite another's guardrails has removed a constraint",
    "that applies to itself the moment that agent runs.",
    "Paths are given as a tool call would supply them. `~` means the user's home."
  ],
  "cases": [
    {
      "path": "~/.claude/settings.json",
      "blocked": true,
      "why": "Claude harness settings"
    },
    {
      "path": "~/.claude.json",
      "blocked": true,
      "why": "Claude project state"
    },
    {
      "path": "~/.claude/hooks/block-dangerous-bash.sh",
      "blocked": true,
      "why": "deployed Claude hook"
    },
    {
      "path": "~/.codex/config.toml",
      "blocked": true,
      "why": "Codex main configuration"
    },
    {
      "path": "~/.codex/auth.json",
      "blocked": true,
      "why": "Codex credentials"
    },
    {
      "path": "~/.codex/review.config.toml",
      "blocked": true,
      "why": "profile layer that can widen the base config"
    },
    {
      "path": "~/.codex/rules/default.rules",
      "blocked": true,
      "why": "Codex permission rules"
    },
    {
      "path": "~/.copilot/hooks/security-policy.json",
      "blocked": true,
      "why": "Copilot hook registration"
    },
    {
      "path": "~/.pi/agent/settings.json",
      "blocked": true,
      "why": "pi settings"
    },
    {
      "path": "~/.pi/agent/git/github.com/ahgraber/sentinel-hooks/plugins/sentinel/harnesses/pi/hook-dispatch.py",
      "blocked": true,
      "why": "the pi hook dispatcher in an installed copy"
    },
    {
      "path": "~/.pi/agent/hooks.json",
      "blocked": true,
      "why": "pi hook registration"
    },
    {
      "path": "~/.pi/agent/extensions/hooks/extension.ts",
      "blocked": true,
      "why": "deployed pi hook runner"
    },
    {
      "path": "~/.pi/agent/extensions/sandbox.json",
      "blocked": true,
      "why": "pi sandbox configuration"
    },
    {
      "path": "~/.claude/plugins/cache/sentinel-hooks/sentinel/0.1.0/harnesses/claude/hooks.json",
      "blocked": true,
      "why": "the Claude registration in an installed copy"
    },
    {
      "path": "~/.codex/plugins/cache/sentinel-hooks/sentinel/0.1.0/hooks/block-dangerous-bash.sh",
      "blocked": true,
      "why": "a hook in an installed copy, shared by every agent"
    },
    {
      "path": ".codex/rules/default.rules",
      "blocked": true,
      "why": "the project's Codex rules"
    },
    {
      "path": "~/.copilot/installed-plugins/sentinel-hooks/sentinel/com.github.copilot/hooks/hooks.json",
      "blocked": true,
      "why": "the Copilot registration in an installed copy"
    },
    {
      "path": "~/.pi/agent/git/github.com/ahgraber/sentinel-hooks/plugins/sentinel/harnesses/pi/hooks.json",
      "blocked": true,
      "why": "the pi hook registration in an installed copy"
    },
    {
      "path": "~/.pi/agent/git/github.com/ahgraber/sentinel-hooks/plugins/sentinel/harnesses/pi/extension/extension.ts",
      "blocked": true,
      "why": "the pi hook runner in an installed copy"
    },
    {
      "path": ".claude/settings.local.json",
      "blocked": true,
      "why": "the project's Claude settings"
    },
    {
      "path": ".codex/hooks.json",
      "blocked": true,
      "why": "the project's Codex hook registration"
    },
    {
      "path": "~/.claude/hooks/instructions/00-response-style.md",
      "blocked": true,
      "why": "instruction text is guarded enforcement"
    },
    {
      "path": "~/.claude/plugins/cache/sentinel-hooks/sentinel/0.1.0/hooks/instructions/00-response-style.md",
      "blocked": true,
      "why": "instruction text is guarded enforcement"
    },
    {
      "path": "~/.claude/plugins/cache/sentinel-hooks/sentinel/0.1.0/hooks/instructions/nested/note.md",
      "blocked": true,
      "why": "instruction text is guarded enforcement"
    },
    {
      "path": "~/.claude/plugins/cache/sentinel-hooks/sentinel/0.1.0/hooks/instructions/helper.py",
      "blocked": true,
      "why": "instruction text is guarded enforcement"
    },
    {
      "path": "~/.claude/skills/deploy/SKILL.md",
      "blocked": true,
      "why": "an agent's whole home directory is guarded, not only the files named here"
    },
    {
      "path": "~/.copilot/config.json",
      "blocked": true,
      "why": "same, for Copilot"
    },
    {
      "path": "~/.pi/agent/extensions/other/index.ts",
      "blocked": true,
      "why": "every pi extension is enforcement, not only the two this repository ships"
    },
    {
      "path": "~/.pi/agent/npm/lib/node_modules/pkg/index.js",
      "blocked": true,
      "why": "all paths within the declared Pi agent home are guarded"
    },
    {
      "path": "src/main.py",
      "blocked": false,
      "why": "ordinary source"
    },
    {
      "path": "README.md",
      "blocked": false,
      "why": "ordinary markdown outside any instructions directory"
    },
    {
      "path": "~/backups/.claude/settings.json",
      "blocked": false,
      "why": "an absolute path is judged by where it leads, so a copy that merely shares a guarded name is not the guarded file"
    },
    {
      "path": "~/Downloads/.codex/hooks.json",
      "blocked": false,
      "why": "same, for a project-file spelling that sits in no repository"
    },
    {
      "path": "~/.pi/agent/npm/node_modules/pkg/index.js",
      "blocked": true,
      "why": "Pi keeps its npm packages in the agent home, and a package runs as extension code"
    },
    {
      "path": "~/.claude/projects/demo/memory/note.txt",
      "blocked": false,
      "why": "memory is write-through"
    }
  ]
}

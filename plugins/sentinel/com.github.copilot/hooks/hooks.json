{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" session-tool-checks.sh",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" git-baseline.sh init",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" block-dangerous-bash.sh",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" block-sensitive-paths.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" block-hook-tampering.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" git-baseline.sh check",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" block-destructive-ops.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" block-leaks.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" bash-command-validator.sh",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/harnesses/copilot/copilot-vscode-hook-adapter.py\" git-baseline.sh update",
        "timeout": 10
      }
    ]
  }
}

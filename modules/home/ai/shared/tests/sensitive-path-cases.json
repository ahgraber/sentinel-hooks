{
  "$comment": [
    "Zero-access path verdicts, asserted by every implementation of the policy.",
    "block-sensitive-paths.py is the Python one; pi's security extension is a",
    "TypeScript port that cannot import it. Nothing but a shared table of cases",
    "keeps the two honest — the last drift between them made a guardrail source",
    "unreadable to its own maintainers.",
    "Paths are given as a tool call would supply them. `~` means the user's home."
  ],
  "bash_cases_note": "Shared lexer cases. Pi incorporation and tests are paused by user direction.",
  "bash_cases": [
    {
      "command": "grep -r secret .",
      "blocked": false,
      "exists": []
    },
    {
      "command": "grep -r secret .",
      "blocked": true,
      "exists": [
        "secret"
      ]
    },
    {
      "command": "cat ./secret",
      "blocked": true,
      "exists": []
    },
    {
      "command": "cat ./secret",
      "blocked": true,
      "exists": [
        "secret"
      ]
    },
    {
      "command": "cat '.env'",
      "blocked": true,
      "exists": []
    },
    {
      "command": "cat $'\\056env'",
      "blocked": true,
      "exists": []
    },
    {
      "command": "cat $(cat .env)",
      "blocked": true,
      "exists": []
    },
    {
      "command": "cat id_rsa",
      "blocked": true,
      "exists": []
    }
  ],

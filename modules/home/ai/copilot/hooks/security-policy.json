{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py session-tool-checks.sh",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py session-instructions.sh",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py git-baseline.sh init",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py block-dangerous-bash.sh",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py block-sensitive-paths.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py block-hook-tampering.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py git-baseline.sh check",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py block-destructive-ops.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py block-leaks.py",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py bash-command-validator.sh",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py git-baseline.sh update",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/copilot-vscode-hook-adapter.py stop-precommit.sh",
        "timeout": 300
      }
    ]
  }
}
